//Modify permissions in policy//

{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "AllowSnowflakeAccessToBucket",
			"Effect": "Allow",
			"Action": [
				"s3:GetObject",
				"s3:PutObject",
				"s3:ListBucket"
			],
			"Resource": [
				"arn:aws:s3:::netlixproject",
				"arn:aws:s3:::netlixproject/*"
			]
		}
	]
}


